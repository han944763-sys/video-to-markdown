    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>视频转Markdown</AssemblyName>
    <RootNamespace>VideoMarkdown.App</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
