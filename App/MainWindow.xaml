<Window x:Class="VideoMarkdown.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="视频转 Markdown" Width="1110" Height="790" MinWidth="865" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F2F5FA" Foreground="#142138"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2459CE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2459CE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fill" CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="#1947AC"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fill" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#405471"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20" LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="视频转 Markdown" FontWeight="Bold" FontSize="27"/>
                <TextBlock Text="采集作者作品，批量导出带时间戳的转录稿" Foreground="#536580" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ServiceStatus" Text="正在检查 VideoToNo…" Style="{StaticResource Label}"/>
                <Button Content="启动 VideoToNo" Click="LaunchService"/>
                <Button Content="新建批次" Click="NewBatch"/>
                <Button Content="打开批次" Click="OpenBatch" Margin="0"/>
            </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" CornerRadius="8" Background="White" BorderBrush="#DCE4F0" BorderThickness="1" Padding="13" Margin="0,0,0,12">
            <Grid x:Name="SourceForm">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <TextBlock Text="平台" Style="{StaticResource Label}"/>
                <ComboBox x:Name="PlatformBox" Grid.Column="1" SelectedIndex="0" VerticalAlignment="Center"
                          AutomationProperties.Name="平台" SelectionChanged="PlatformChanged">
                    <ComboBoxItem Content="B 站"/><ComboBoxItem Content="抖音"/><ComboBoxItem Content="YouTube"/>
                </ComboBox>
                <TextBlock Text="作者主页" Grid.Column="2" Margin="12,0,5,0" Style="{StaticResource Label}"/>
                <TextBox x:Name="ProfileBox" Grid.Column="3" Margin="0,2,8,2" AutomationProperties.Name="作者主页"/>
                <StackPanel Orientation="Horizontal" Grid.Column="4">
                    <Button Content="采集主页" Style="{StaticResource Primary}" Click="Collect"/>
                    <Button x:Name="SearchButton" Content="查找抖音作者" Click="SearchDouyin" Margin="0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="发布日期" Style="{StaticResource Label}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <DatePicker x:Name="FromPicker" Width="138" AutomationProperties.Name="开始日期"/>
                    <TextBlock Text="至" VerticalAlignment="Center" Margin="9,0"/>
                    <DatePicker x:Name="ThroughPicker" Width="138" AutomationProperties.Name="结束日期"/>
                    <TextBlock Text="北京时间，含首尾两天" Foreground="#536580" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="输出目录" Style="{StaticResource Label}"/>
                <TextBox x:Name="OutputBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,8,2" AutomationProperties.Name="输出目录"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="4">
                    <Button Content="选择目录" Click="PickOutput"/>
                    <Button Content="打开输出" Click="ShowOutput" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" CornerRadius="8" Background="White" BorderBrush="#DCE4F0" BorderThickness="1" Padding="13" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" MaxHeight="55" Foreground="#314966"
                           Text="输入作者主页，或在「作品列表」导入链接。"/>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="Totals" Text="共 0 条" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StopCollect" Content="停止采集" Click="CancelCollect" IsEnabled="False"/>
                        <Button x:Name="RetryButton" Content="重试失败项" Click="Retry" IsEnabled="False"/>
                        <Button x:Name="PauseButton" Content="完成当前条后暂停" Click="Pause" IsEnabled="False"/>
                        <Button x:Name="ContinueButton" Content="开始 / 继续" Style="{StaticResource Primary}" Click="Start" IsEnabled="False" Margin="0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" Background="White" BorderBrush="#DCE4F0">
            <TabItem x:Name="ListTab" Header="作品列表">
                <DockPanel Margin="10">
                    <Grid x:Name="ImportForm" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LinksBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Height="54" Margin="0,0,8,0" AutomationProperties.Name="作品链接，可粘贴多条"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="添加粘贴的链接" Click="ImportLinks"/>
                            <Button Content="导入 CSV" Click="ImportCsv"/>
                            <Button x:Name="SaveButton" Content="保存批次" Click="SaveBatch" Margin="0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" Text="可粘贴多条作品分享链接。日期待确认的作品需手动勾选。"
                               Foreground="#536580" Margin="0,0,0,8"/>
                    <DataGrid x:Name="WorkGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7ECF5"
                              BorderBrush="#DCE4F0" Background="White" AlternatingRowBackground="#F7F9FD"
                              SelectionMode="Single" RowHeight="31">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="ToggleWork" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="选择此作品"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="发布日期" Binding="{Binding DisplayDate, Mode=OneWay}" Width="117" IsReadOnly="True"/>
                            <DataGridTextColumn Header="作品" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="作品 ID" Binding="{Binding Id, Mode=OneWay}" Width="155" IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus, Mode=OneWay}" Width="116" IsReadOnly="True"/>
                            <DataGridTextColumn Header="处理详情" Binding="{Binding Error, Mode=OneWay}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Error}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="BrowserTab" Header="平台页面">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,7">
                        <TextBlock Text="可在这里登录、验证或选中搜索结果中的作者主页。" Style="{StaticResource Label}"/>
                        <Button Content="打开平台" Click="OpenPlatform"/>
                        <Button Content="使用当前主页" Click="UseCurrentProfile"/>
                        <Button Content="重试采集" Click="Collect"/>
                    </StackPanel>
                    <wv:WebView2 x:Name="PlatformView"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
